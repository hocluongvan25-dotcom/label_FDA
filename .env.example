# Browser-safe Supabase project configuration (NOT a service-role secret)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current Supabase browser key; legacy anon-key alias also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_DEMO=true
# Canonical app origin for invitation email redirects (set in production)
NEXT_PUBLIC_APP_URL=

# Trusted worker/server ONLY; never prefix these with NEXT_PUBLIC_
# Regulatory worker prefers SUPABASE_URL and falls back to the browser URL below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ClamAV daemon with INSTREAM support. Required for production uploads.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Explicitly opt in for local development only. Never enable in production.
ALLOW_UNSCANNED_DEV_UPLOADS=false

# Local OCR is the default; no third-party provider sees labels.
OCR_PROVIDER=local
# Optional approved provider. See docs/PROVIDERS.md for its strict JSON contract.
APPROVED_OCR_URL=
APPROVED_OCR_API_KEY=
APPROVED_LLM_URL=
APPROVED_LLM_API_KEY=
# Provider consent must be explicitly recorded before sending customer evidence.
APPROVED_PROVIDER_CONSENT=false

WORKER_POLL_MS=3000

# Risk triage may label an item AUTO_SCREENED, but issuing its separate artifact
# requires BOTH this explicit staging runtime gate and the database allowlist.
# Leave disabled in production and until synthetic staging qualification passes.
REGULATORY_PRE_SCREENING_ENABLED=false
REGULATORY_PRE_SCREENING_ENV=disabled
# Set exactly to staging only in the isolated staging worker runtime.
DEPLOYMENT_ENV=

# Official regulatory API ingestion (NO customer data sent upstream)
# The separate worker refuses to run unless explicitly set to staging.
REGULATORY_WORKER_ENV=
REGULATORY_CONTACT_EMAIL=
REGULATORY_POLL_MS=5000
